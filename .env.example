APP_NAME=Case-Agnostic Backend Starter
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app
TRITON_URL=http://triton:8000
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
DGIS_BROWSER_KEY=
DGIS_API_KEY=
DGIS_BASE_URL=https://catalog.api.2gis.com
DGIS_LOCALE=ru_RU
DGIS_TIMEOUT_SECONDS=30

# Explicit opt-in: disabled / mock / triton
INFERENCE_MODE=disabled
TRITON_MODEL_NAME=detection
TRITON_MODEL_VERSION=1
TRITON_TIMEOUT_SECONDS=30
# GPU server only; verify driver compatibility
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:25.06-py3
BACKEND_BIND=127.0.0.1
